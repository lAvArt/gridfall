#!/bin/bash
# Start the Gridfall screensaver on every monitor (one fullscreen window each), unless it is already up or the
# session is locked. Run by the plugin service on idle; also fine to bind to a key for a preview.
set -u

pgrep -x gridfall >/dev/null 2>&1 && exit 0
[[ $(omarchy-shell lock isLocked 2>/dev/null) == "true" ]] && exit 0

root="$(cd "$(dirname "$(readlink -f "$0")")/.." && pwd)"
bin=""
for c in "$HOME/.cargo/bin/gridfall" "$HOME/.local/bin/gridfall" "$root/target/release/gridfall" "$(command -v gridfall 2>/dev/null)"; do
  if [[ -n "$c" && -x "$c" ]]; then
    bin="$c"
    break
  fi
done
if [[ -z "$bin" ]]; then
  notify-send -u normal "Gridfall" "Not built yet. Run: cargo install --locked --path $root" 2>/dev/null
  exit 1
fi

focus_monitor() {
  hyprctl dispatch "hl.dsp.focus({ monitor = \"$1\" })" >/dev/null 2>&1 || hyprctl dispatch focusmonitor "$1" >/dev/null 2>&1
}
hypr_exec() {
  local cmd
  printf -v cmd '%q ' "$@"
  hyprctl dispatch "hl.dsp.exec_cmd([[$cmd]])" >/dev/null 2>&1 || hyprctl dispatch exec -- "$cmd" >/dev/null 2>&1
}

focused=$(hyprctl monitors -j 2>/dev/null | jq -r '.[] | select(.focused) | .name' 2>/dev/null)
monitors=$(hyprctl monitors -j 2>/dev/null | jq -r '.[].name' 2>/dev/null)
if [[ -z "$monitors" ]]; then
  "$bin" >/dev/null 2>&1 &
  exit 0
fi
count() { hyprctl clients -j 2>/dev/null | jq '[.[] | select(.class == "org.omarchy.screensaver")] | length' 2>/dev/null || echo 0; }
for m in $monitors; do
  n0=$(count)
  focus_monitor "$m"
  hypr_exec "$bin"
  # let this monitor's window open before moving focus on
  for _ in $(seq 30); do
    sleep 0.1
    (($(count) > n0)) && break
  done
done
[[ -n "$focused" ]] && focus_monitor "$focused"
exit 0
